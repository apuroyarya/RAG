DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
QDRANT_URL=http://localhost:6333
STORAGE_DIR=storage

# Phase 1 is monolingual Bengali.
DEFAULT_LANGUAGE=bn

# tesseract is the current stopgap - free, self-hosted, and good enough to get
# real text through the pipeline, but it substitutes Latin words where it fails
# on Bengali. Run tools/ocr_bench to compare against google_vision / azure_di /
# surya before committing. Empty means the ocr stage refuses rather than guesses.
OCR_ENGINE=tesseract

# Both optional - the adapter finds the binary and ./.tessdata automatically.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_PREFIX=./.tessdata
OCR_DPI=300

# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# AZURE_DI_ENDPOINT=
# AZURE_DI_KEY=

# A page whose Bengali words begin with a dependent vowel sign is corrupt.
# The honest threshold is 0; this leaves a hair of slack for stray artefacts.
VALIDITY_THRESHOLD=0.005
