DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# Empty means embedded mode: a local directory, no server, no Docker. Embedded
# mode takes an EXCLUSIVE lock on that directory, so only one process can hold
# it - point this at a server for anything concurrent.
QDRANT_URL=
QDRANT_PATH=qdrant_data
QDRANT_COLLECTION=chunks
STORAGE_DIR=storage

# Phase 1 is monolingual Bengali.
DEFAULT_LANGUAGE=bn

# tesseract is the current stopgap - free, self-hosted, and good enough to get
# real text through the pipeline, but it substitutes Latin words where it fails
# on Bengali. Run tools/ocr_bench to compare against google_vision / azure_di /
# surya before committing. Empty means the ocr stage refuses rather than guesses.
OCR_ENGINE=tesseract

# Both optional - the adapter finds the binary and ./.tessdata automatically.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_PREFIX=./.tessdata
OCR_DPI=300

# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# AZURE_DI_ENDPOINT=
# AZURE_DI_KEY=

# A page whose Bengali words begin with a dependent vowel sign is corrupt.
# The honest threshold is 0; this leaves a hair of slack for stray artefacts.
VALIDITY_THRESHOLD=0.005

# Embedding backend: sentence_transformers (real) or fake (hashed vectors for
# plumbing tests only - no semantic meaning, never tune thresholds against it).
EMBED_BACKEND=sentence_transformers
EMBED_MODEL=BAAI/bge-m3
EMBED_BATCH_SIZE=8

# Chunk sizing in characters, not tokens - Bengali tokenizes far heavier than
# English and the real ratio depends on the embedder's tokenizer.
CHUNK_TARGET_CHARS=400
CHUNK_MAX_CHARS=700
CHUNK_MIN_CHARS=80
CHUNK_OVERLAP_CHARS=60

# Retrieval and abstention
RETRIEVE_DENSE_K=30
RETRIEVE_RERANK_K=8
MAX_CONTEXT_SPANS=5

# cross_encoder (real) or passthrough (plumbing only - gates on embedding
# cosine, which is not calibrated for thresholding).
RERANK_BACKEND=cross_encoder
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# PLACEHOLDER, NOT CALIBRATED. Must be measured on the eval set.
ABSTAIN_THRESHOLD=0.0
GROUNDING_MIN_OVERLAP=0.6

ANSWER_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=...
