DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
QDRANT_URL=http://localhost:6333
STORAGE_DIR=storage

# Phase 1 is monolingual Bengali.
DEFAULT_LANGUAGE=bn

# Left empty on purpose: the ocr stage refuses to guess an engine.
# Run tools/ocr_bench to pick one, then set it to google_vision, azure_di,
# surya or tesseract - plus that engine's own credentials.
OCR_ENGINE=
OCR_DPI=300

# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# AZURE_DI_ENDPOINT=
# AZURE_DI_KEY=

# A page whose Bengali words begin with a dependent vowel sign is corrupt.
# The honest threshold is 0; this leaves a hair of slack for stray artefacts.
VALIDITY_THRESHOLD=0.005
